{
  "name": "sisir",
  "version": "0.1.0",
  "description": "Post-quantum Solidity linter for QoreChain contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimanmalib/sisir.git"
  },
  "homepage": "https://sisir.sasateguh.com",
  "bin": {
    "sisir": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/rules/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gate": "bash scripts/gerbang-ujian.sh"
  },
  "dependencies": {
    "@solidity-parser/parser": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
