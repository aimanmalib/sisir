# Copy to deploy/hos.env (not tracked) and fill in the values for your host.
SISIR_DOMAIN=sisir.example.com
# Docker network the reverse proxy shares with the container.
SISIR_NETWORK=proxy
# Traefik container and the folder it watches for dynamic configuration.
PROXY_CONTAINER=traefik
PROXY_DYNAMIC_DIR=/traefik/dynamic
CERT_RESOLVER=letsencrypt
# Any image builder that accepts `docker build` arguments.
BUILD_CMD="docker build"
# Command called as `<cmd> "<text>" warn` when the health check fails twice in a row. Empty = no alert.
NOTIFY_CMD=
MIN_FREE_GB=20
