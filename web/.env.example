# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: use another SisirLedger than contracts.sisirLedger in config/app.json
# (a local node, or the fake chain in e2e/). Leave empty for the deployed one.
VITE_SISIR_LEDGER=
